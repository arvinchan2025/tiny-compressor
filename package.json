{
  "name": "tinycompressor",
  "version": "1.0.0",
  "description": "A modern image compression tool",
  "private": true,
  "scripts": {
    "dev": "npm run build:translations && concurrently \"npm run watch:translations\" \"next dev\"",
    "dev:simple": "next dev",
    "dev:setup": "npm run build:translations",
    "dev:start": "next dev",
    "dev:clean": "npm run clean && npm run dev:setup && next dev",
    "build": "npm run build:translations && next build",
    "build:translations": "node scripts/build-translations.js",
    "watch:translations": "node scripts/watch-translations.js",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:quick": "playwright test e2e/quick-smoke-test.spec.ts",
    "test:e2e:pages": "playwright test e2e/all-pages-smoke-test.spec.ts",
    "test:e2e:compress": "playwright test e2e/compression-functionality.spec.ts",
    "test:e2e:convert": "playwright test e2e/conversion-functionality.spec.ts",
    "test:e2e:detailed": "playwright test e2e/functional-pages-detailed.spec.ts",
    "test:e2e:compress:real": "playwright test e2e/image-compression-real.spec.ts",
    "test:e2e:convert:real": "playwright test e2e/image-conversion-real.spec.ts",
    "test:e2e:functional": "playwright test e2e/image-compression-real.spec.ts e2e/image-conversion-real.spec.ts",
    "test:e2e:report": "playwright show-report",
    "test:images:create": "node scripts/create-better-test-images.js",
    "test:all": "npm run test && npm run test:e2e",
    "deploy:local": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh local",
    "deploy:docker": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh docker",
    "deploy:server": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh server",
    "health": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh health",
    "docker:build": "docker build -t tinycompressor:latest .",
    "docker:run": "docker run -p 3000:3000 tinycompressor:latest",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "analyze": "ANALYZE=true npm run build",
    "clean": "rm -rf .next node_modules/.cache lib/i18n/generated",
    "fresh": "npm run clean && npm install && npm run build",
    "generate:translations": "node scripts/build-translations.js",
    "check:encoding": "powershell -ExecutionPolicy Bypass -File scripts/check-encoding.ps1",
    "fix:encoding": "powershell -ExecutionPolicy Bypass -File scripts/check-encoding.ps1 -AutoFix",
    "generate:critical": "node scripts/generate-critical-translations.js",
    "generate:modules": "node scripts/generate-modular-translations.js",
    "generate:optimized": "npm run generate:critical && npm run generate:modules",
    "prebuild": "npm run generate:optimized",
    "postinstall": "npm run generate:optimized",
    "precommit": "npm run lint && npm run type-check && npm run test",
    "i18n:generate": "npm run generate:translations",
    "i18n:watch": "npm run watch:translations",
    "i18n:clean": "rm -rf lib/i18n/generated"
  },
  "dependencies": {
    "@squoosh/lib": "^0.4.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "browser-image-compression": "^2.0.0",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "file-type": "^19.0.0",
    "framer-motion": "^10.16.0",
    "jszip": "^3.10.0",
    "lucide-react": "^0.292.0",
    "next": "^14.0.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.0",
    "react-hook-form": "^7.48.0",
    "react-hot-toast": "^2.4.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.10"
  }
}
